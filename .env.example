# ==============================================================================
# SmartPay - Production & Development Environment Configuration Template
# Copy this file to .env or set corresponding environment variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite / React)
# ------------------------------------------------------------------------------
# Backend Spring Boot API Base URL (default: http://localhost:8080/api/v1)
# For mobile testing on local Wi-Fi, replace localhost with your LAN IP (e.g. http://192.168.1.x:8080/api/v1)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Application Identity & Branding
VITE_APP_NAME=SmartPay
VITE_APP_TAGLINE=Pay Smart. Live Secure.
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot 3.3.5 / Java 21)
# ------------------------------------------------------------------------------
# Server Port
SERVER_PORT=8080

# MySQL Database Configuration (XAMPP default: root with empty password)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/smartpay_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Hibernate DDL Auto (update for development, validate/none for production)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Authentication Configuration (HS256 256-bit Hex Key)
SMARTPAY_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
SMARTPAY_JWT_EXPIRATION_MS=86400000
SMARTPAY_JWT_REFRESH_EXPIRATION_MS=604800000

# NPCI & Payment Engine Simulation
SMARTPAY_NPCI_SIMULATION_MODE=true
SMARTPAY_FRAUD_SHIELD_ENABLED=true
